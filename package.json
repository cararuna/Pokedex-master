{
  "name": "pokedex",
  "version": "1.0.0",
  "private": true,
  "description": "Pokédex — design system, API e agente de IA",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter @pokedex/web dev",
    "dev:api": "pnpm --filter @pokedex/api dev",
    "storybook": "pnpm --filter @pokedex/design-system storybook",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r exec rm -rf dist node_modules .vite",
    "seed": "pnpm --filter @pokedex/api seed",
    "ingest": "pnpm --filter @pokedex/api ingest",
    "eval": "pnpm --filter @pokedex/evals eval"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@supabase/supabase-js": "^2.111.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.33",
    "openai": "^7.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3"
  }
}
