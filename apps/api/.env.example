# Copie para .env e preencha. O .env está no .gitignore e nunca é versionado.
# Passo a passo para obter cada valor: SETUP.md na raiz do repositório.

# ── Supabase ────────────────────────────────────────────────────────────────
# Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# A service_role IGNORA todas as regras de segurança do banco.
# Só existe aqui, no backend. Nunca no frontend, nunca com prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenRouter ──────────────────────────────────────────────────────────────
# https://openrouter.ai → Keys → Create Key
OPENROUTER_API_KEY=

# Trocar de modelo é mudar esta linha — nenhum código muda.
# É o que permite rodar o mesmo eval contra vários modelos e comparar
# custo versus qualidade.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_EMBEDDING_MODEL=cohere/embed-v1

# ── Servidor ────────────────────────────────────────────────────────────────
PORT=8787
WEB_ORIGIN=http://localhost:3000
