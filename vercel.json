{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @pokedex/web build",
  "outputDirectory": "apps/web/dist",

  "functions": {
    "api/[[...route]].ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },

  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
